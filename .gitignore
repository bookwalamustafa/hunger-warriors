# Hunger Warriors: static website
# The repo holds only what the live site needs:
#   index.html, gallery.html, css/, js/, content/, assets/, README.md

# OS clutter
.DS_Store
._*
Thumbs.db
desktop.ini

# Editors and AI tools
.vscode/
.idea/
.claude/
*.swp
*~

# Local preview / test files
_*.html
*.log

# Photo originals and work-in-progress (keep these outside the site, or here)
/originals/
/raw/
*.HEIC
*.heic
*.psd

# Secrets: never commit keys (e.g. PhonePe merchant keys)
.env
.env.*

# Hosting tool caches (if you deploy with a CLI later)
.netlify/
.vercel/
node_modules/
